function hari() {
    local session="Gaurav"
    local tmux_cmd

    if [[ "$1" == "-d" ]]; then
        session="Gaurav-$(basename $(pwd))"
        shift
    fi

    if [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]]; then
        tmux_cmd="tmux -CC new -A -s '$session'"
    else
        tmux_cmd="tmux a -t '$session' || tmux new -s '$session'"
    fi

    local attempt=0
    local max_attempts=36 # 36 * 5s = 180s = 3 mins

    while [[ $attempt -lt $max_attempts ]]; do
        ssh "$@" -t "$tmux_cmd || screen -r || screen || /bin/bash"
        local exit_code=$?

        # 255 indicates an SSH connection error (e.g., Network unreachable)
        if [[ $exit_code -eq 255 ]]; then
            echo "hari: SSH connection failed. Retrying in 5 seconds... ($((attempt + 1))/$max_attempts)"
            sleep 5
            ((attempt++))
        else
            return $exit_code
        fi
    done

    echo "hari: Could not connect after 3 minutes."
    return 255
}
