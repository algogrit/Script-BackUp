#!/usr/bin/env bash
set -e

# Defaults
max_mb=2                          # 2 MiB
max_size=$((2 * 1024 * 1024))   # 2 MiB in bytes
resize=""                         # empty = keep native resolution
quality=100
min_quality=20
out="out.pdf"
no_convert=0

usage() {
    cat <<EOF
shrinktopdf - Convert or combine images into a PDF under a target size

Usage: shrinktopdf [options] files...

Modes:
  Default: convert + compress + shrink to target size.
  -N, --no-convert: merge images AS-IS (no resize/quality/conversion).

Options:
  -o <file>        Output PDF (default: out.pdf)
  -s <MB>          Max PDF size in MB, decimals OK (default: 2)
  -r <WxH>         Resize/downscale pages (default: keep native resolution)
  -m <num>         Minimum quality (default: 20)
  -N, --no-convert Do not convert/resize/compress images; merge them as-is (Recover using: 'pdfimages -all out.pdf extracted')
  -h, --help       Show help

You may place options anywhere, even after filenames.
EOF
    exit 0
}

# Manual option parsing to allow "options anywhere"
inputs=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)
            out="$2"; shift 2 ;;
        -s)
            max_mb="$2"
            max_size=$(awk "BEGIN{printf \"%d\", $max_mb * 1024 * 1024}")
            shift 2 ;;
        -r)
            resize="$2"; shift 2 ;;
        -m)
            min_quality="$2"; shift 2 ;;
        -N|--no-convert)
            no_convert=1; shift ;;
        -h|--help)
            usage ;;
        --)
            shift
            # Everything after -- is input
            while [[ $# -gt 0 ]]; do inputs+=("$1"); shift; done
            break ;;
        -*)
            echo "Unknown option: $1"
            exit 1 ;;
        *)
            # Positional input file
            inputs+=("$1"); shift ;;
    esac
done

# No inputs?
if [[ ${#inputs[@]} -eq 0 ]]; then
    echo "Error: No input images provided."
    echo "Use: shrinktopdf [options] files..."
    exit 1
fi

# AS-IS merge mode
if [[ $no_convert -eq 1 ]]; then
    echo "📄 Creating PDF from images as-is..."
    magick "${inputs[@]}" "$out"

    size=$(stat -c%s "$out" 2>/dev/null || stat -f%z "$out")
    echo "✔ Created $out ($((size/1024)) KiB) with no conversion."
    exit 0
fi

# Shrink mode
tmpdir=$(mktemp -d)
trap "rm -rf $tmpdir" EXIT

# Only resize when the user asked for it (constant across builds)
resize_args=()
[[ -n "$resize" ]] && resize_args=(-resize "$resize")

# Build the PDF at a given quality; echoes the resulting size in bytes.
build_pdf() {
    local q=$1
    rm -f "$out"

    # Convert inputs → JPEGs
    for f in "${inputs[@]}"; do
        base=$(basename "$f")
        base="${base%.*}"
        magick "$f" "${resize_args[@]}" -quality "$q" "$tmpdir/$base.jpg"
    done

    # Create PDF — let each page keep its own resolution/density so
    # full-res scans stay sharp and physically letter-sized.
    magick "$tmpdir"/*.jpg -compress JPEG -quality "$q" "$out"

    stat -c%s "$out" 2>/dev/null || stat -f%z "$out"
}

# Binary-search the highest quality that fits under max_size.
lo=$min_quality
hi=$quality
best_q=-1
best_size=0
last_q=-1

while [[ $lo -le $hi ]]; do
    mid=$(( (lo + hi) / 2 ))
    size=$(build_pdf "$mid")
    last_q=$mid

    if [[ "$size" -lt "$max_size" ]]; then
        best_q=$mid; best_size=$size
        echo "quality=$mid → $((size/1024)) KiB ✓ fits (trying higher)"
        lo=$(( mid + 1 ))
    else
        echo "quality=$mid → $((size/1024)) KiB ✗ too large (trying lower)"
        hi=$(( mid - 1 ))
    fi
done

if [[ $best_q -lt 0 ]]; then
    echo "✘ Could not shrink under ${max_mb} MB even at minimum quality."
    exit 1
fi

# The last build may have been a failing higher quality — rebuild the winner.
if [[ $last_q -ne $best_q ]]; then
    best_size=$(build_pdf "$best_q")
fi
echo "✔ Success: $out is $((best_size/1024)) KiB (quality=$best_q)"
exit 0
