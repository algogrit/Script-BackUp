#!/usr/bin/env python3
"""sc - Screenshot utility for macOS.

Commands:
  sc              Print path + copy image to clipboard
  sc -p           Print path + copy path to clipboard
  sc print        Print the latest screenshot path
  sc list         List all screenshots
  sc open         Open the latest screenshot
  sc cp [-p]      Copy image (or path with -p) to clipboard
  sc mv <dest>    Move latest screenshot (defaults to screenshots/<today>/<dest>)
  sc clean [-n]   Remove all screenshots except the latest
  sc nuke  [-n]   Remove ALL screenshots
  sc auto on|off|status            Per-dir auto date-prefix (default: on)
  sc sync [-n] [--to <host>] [--remote-home <path> | --remote-dir <path>]
                                   Push ./screenshots to a remote project (rsync)
  sc sync config                  Show project mapping and global fallback
  sc sync config <host> <remote-home>   Set the global home-mirroring fallback
  sc sync config <host> --remote-dir <path>   Map this local project to a remote project
"""

import argparse
import json
import os
import posixpath
import shlex
import shutil
import subprocess
import sys
from datetime import datetime
from glob import glob

HOME = os.environ.get("HOME", os.path.expanduser("~"))
PWD = os.environ.get("PWD", os.getcwd())  # logical cwd, matches bash $PWD

SCREENSHOT_DIR = os.path.join(HOME, "Desktop")

# Auto date-prefix settings (used by `sc mv` when active for the current dir)
# Legacy plain paths mean ON; "off\t/absolute/path" entries mean OFF.
CONFIG_FILE = os.environ.get("SC_CONFIG_FILE", os.path.join(HOME, ".config/sc/config"))
AUTO_BASE_DIR = "screenshots"   # base dir (relative to cwd) for auto-prefixed moves
AUTO_DATE_FMT = "%Y-%m-%d"      # date subdir format

# Sync settings (used by `sc sync` to rsync ./screenshots to a remote host)
SYNC_CONFIG_FILE = os.environ.get("SC_SYNC_CONFIG_FILE", os.path.join(HOME, ".config/sc/sync"))  # KEY=value
# Per-host remote-home cache for `sc sync --to`, one "host=/abs/home" per line. Kept out of
# SYNC_CONFIG_FILE because `sc sync config` rewrites that file wholesale.
SYNC_HOMES_FILE = os.environ.get("SC_SYNC_HOMES_FILE", os.path.join(HOME, ".config/sc/sync-homes"))
SYNC_PROJECTS_FILE = os.environ.get("SC_SYNC_PROJECTS_FILE", os.path.join(HOME, ".config/sc/sync-projects.json"))

# Global flags, populated by main() before dispatch.
COPY_PATH = False
DRY_RUN = False


# --- helpers ---------------------------------------------------------------

def short(path):
    """Shorten a leading $HOME to ~ in displayed paths (only at the start)."""
    if path == HOME:
        return "~"
    if path.startswith(HOME + "/"):
        return "~" + path[len(HOME):]
    return path


def all_screenshots():
    """All 'Screenshot *.png' files in SCREENSHOT_DIR, newest first (like `ls -t`)."""
    files = glob(os.path.join(SCREENSHOT_DIR, "Screenshot *.png"))
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)
    return files


def latest():
    """The most recent screenshot, or None."""
    files = all_screenshots()
    return files[0] if files else None


def copy_path(file):
    subprocess.run(["pbcopy"], input=file.encode())
    print("Copied path to clipboard.")


def copy_image(file):
    jpeg = f'set the clipboard to (read (POSIX file "{file}") as JPEG picture)'
    png = f'set the clipboard to (read (POSIX file "{file}") as PNG picture)'
    result = subprocess.run(["osascript", "-e", jpeg],
                            stderr=subprocess.DEVNULL)
    if result.returncode != 0:
        subprocess.run(["osascript", "-e", png])
    print("Copied image to clipboard.")


def copy_to_clipboard(file):
    if COPY_PATH:
        copy_path(file)
    else:
        copy_image(file)


def is_within(path, directory):
    """Match a directory or descendant without matching sibling name prefixes."""
    return path == directory or path.startswith(directory.rstrip("/") + "/")


def nearest_setting(settings):
    """Return the closest configured ancestor and its value, or (None, None)."""
    matches = [directory for directory in settings if is_within(PWD, directory)]
    if not matches:
        return None, None
    directory = max(matches, key=len)
    return directory, settings[directory]


def load_auto_settings():
    settings = {}
    if not os.path.isfile(CONFIG_FILE):
        return settings
    with open(CONFIG_FILE) as fh:
        for line in fh:
            directory = line.rstrip("\n")
            enabled = not directory.startswith("off\t")
            if not enabled:
                directory = directory[4:]
            if directory.startswith("/"):
                settings[os.path.normpath(directory)] = enabled
    return settings


def auto_state():
    """Return the effective ON/OFF setting and its source; default to ON."""
    if "SC_AUTO_PREFIX" in os.environ:
        value = os.environ["SC_AUTO_PREFIX"]
        return value == "1", f"forced by SC_AUTO_PREFIX={value}"
    directory, enabled = nearest_setting(load_auto_settings())
    if directory is not None:
        return enabled, f"directory setting: {short(directory)}"
    return True, "default"


def auto_active():
    """Whether auto date-prefix should apply for the current cwd.

    SC_AUTO_PREFIX (if set) overrides the registry: '1' = on, anything else = off.
    """
    return auto_state()[0]


def load_project_settings():
    if not os.path.isfile(SYNC_PROJECTS_FILE):
        return {}
    with open(SYNC_PROJECTS_FILE) as fh:
        settings = json.load(fh)
    if not isinstance(settings, dict):
        raise ValueError(f"Invalid project mappings in {short(SYNC_PROJECTS_FILE)}")
    for directory, target in settings.items():
        if (not directory.startswith("/") or not isinstance(target, dict)
                or not isinstance(target.get("host"), str) or not target["host"]
                or not isinstance(target.get("remote_dir"), str)
                or not target["remote_dir"].startswith("/")):
            raise ValueError(f"Invalid project mapping for {directory!r}")
    return settings


def project_remote_dir(directory, target):
    relative = os.path.relpath(PWD, directory)
    if relative == ".":
        return target["remote_dir"]
    return posixpath.join(target["remote_dir"], relative)


def ensure_config_dir(path):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)


def load_sync_config():
    """Resolve (host, remote_home, source) for `sc sync`.

    Precedence: env vars (SC_SYNC_HOST / SC_SYNC_REMOTE_HOME, with OM_HOST as a host
    fallback) win over the stored config file, parsed manually so env stays authoritative.
    """
    host = os.environ.get("SC_SYNC_HOST") or os.environ.get("OM_HOST") or ""
    remote_home = os.environ.get("SC_SYNC_REMOTE_HOME") or ""
    source = "env"
    if os.path.isfile(SYNC_CONFIG_FILE):
        with open(SYNC_CONFIG_FILE) as fh:
            for line in fh:
                k, _, v = line.rstrip("\n").partition("=")
                if k == "SC_SYNC_HOST" and not host:
                    host, source = v, "config"
                elif k == "SC_SYNC_REMOTE_HOME" and not remote_home:
                    remote_home, source = v, "config"
    return host, remote_home, source


def load_home_cache():
    """Remembered remote homes as {host: path}, from previous `sc sync --to` probes."""
    cache = {}
    if os.path.isfile(SYNC_HOMES_FILE):
        with open(SYNC_HOMES_FILE) as fh:
            for line in fh:
                k, sep, v = line.rstrip("\n").partition("=")
                if k and sep and v:
                    cache[k] = v
    return cache


def save_home_cache(host, path):
    """Remember <host>'s remote home. Best effort: a write failure is not fatal."""
    cache = load_home_cache()
    cache[host] = path
    try:
        ensure_config_dir(SYNC_HOMES_FILE)
        with open(SYNC_HOMES_FILE, "w") as fh:
            for k in sorted(cache):
                fh.write(f"{k}={cache[k]}\n")
    except OSError:
        print(f"Note: could not cache remote home in {short(SYNC_HOMES_FILE)}")


def detect_remote_home(host):
    """Ask <host> for $HOME over ssh. Returns an absolute path, or None."""
    print(f"Resolving remote home for {host}...")
    # BatchMode keeps an unreachable/unconfigured host from hanging on a password prompt.
    result = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", host, 'printf %s "$HOME"'],
        capture_output=True, text=True)
    home = result.stdout.strip()
    if result.returncode != 0 or not home.startswith("/"):
        return None
    return home


# --- commands --------------------------------------------------------------

def cmd_print():
    file = latest()
    if not file:
        print("No screenshots found.")
        return 1
    print(short(file))
    return 0


def cmd_list():
    files = all_screenshots()
    if not files:
        print("No screenshots found.")
        return 0
    for f in files:
        print(short(f))
    print()
    print(f"{len(files)} screenshot(s).")
    return 0


def cmd_open():
    file = latest()
    if not file:
        print("No screenshots found.")
        return 1
    print(short(file))
    subprocess.run(["open", file])
    return 0


def cmd_cp():
    file = latest()
    if not file:
        print("No screenshots found.")
        return 1
    print(short(file))
    copy_to_clipboard(file)
    return 0


def cmd_mv(dest):
    if not dest:
        print("Usage: sc mv <destination>")
        print("  e.g. sc mv screenshots/2026-05-03/my-screenshot.png")
        return 1
    file = latest()
    if not file:
        print("No screenshots found.")
        return 1
    # Ignore redundant leading ./ without changing the meaning of other paths.
    while dest.startswith("./"):
        dest = dest[2:]
    dest = dest or "."
    # Absolute, tilde, and existing screenshots destinations are explicit.
    if (auto_active()
            and not dest.startswith("/")
            and not dest.startswith("~")
            and dest != AUTO_BASE_DIR
            and not dest.startswith(AUTO_BASE_DIR + "/")):
        dest = f"{AUTO_BASE_DIR}/{datetime.now().strftime(AUTO_DATE_FMT)}/{dest}"
    # Resolve destination: if no .png extension, treat as directory and keep original filename
    if not dest.endswith(".png"):
        base = dest[:-1] if dest.endswith("/") else dest  # strip one trailing slash, like ${DEST%/}
        dest = f"{base}/{os.path.basename(file)}"
    # Expand a leading ~ (relative paths resolved from cwd)
    if dest.startswith("~"):
        dest = HOME + dest[1:]
    dest_dir = os.path.dirname(dest)
    try:
        if dest_dir:
            os.makedirs(dest_dir, exist_ok=True)
    except OSError:
        print(f"Failed to create directory: {dest_dir}")
        return 1
    shutil.move(file, dest)
    print(f"{short(file)}  →  {short(dest)}")
    return 0


def cmd_auto(sub):
    if sub in ("on", "off"):
        settings = load_auto_settings()
        if DRY_RUN:
            print(f"Would set auto date-prefix: {sub.upper()} for {short(PWD)}")
            return 0
        settings[PWD] = sub == "on"
        ensure_config_dir(CONFIG_FILE)
        with open(CONFIG_FILE, "w") as fh:
            for directory, enabled in sorted(settings.items()):
                fh.write(("" if enabled else "off\t") + directory + "\n")
        print(f"Auto date-prefix: {sub.upper()} for {short(PWD)} (saved)")
        if "SC_AUTO_PREFIX" in os.environ:
            cmd_auto("status")
        return 0

    if sub == "status":
        enabled, source = auto_state()
        print(f"Auto date-prefix: {'ON' if enabled else 'OFF'} for {short(PWD)} ({source})")
        return 0

    print("Usage: sc auto [on|off|status]")
    return 1


def sync_config_usage():
    print("Usage: sc sync config <host> --remote-dir <project-path>  (this project)")
    print("       sc sync config <host> <remote-home>  (global home mirroring)")


def cmd_sync_config(rest, to, remote_home_arg, remote_dir_arg):
    if to or remote_home_arg:
        print("--to / --remote-home apply to the push, not to `sc sync config`.")
        sync_config_usage()
        return 1
    if len(rest) == 1 and not remote_dir_arg:
        directory, target = nearest_setting(load_project_settings())
        host, remote_home, source = load_sync_config()
        if not target and not host and not remote_home:
            print("Sync not configured.")
            sync_config_usage()
            return 1
        if target:
            remote_dir = project_remote_dir(directory, target)
            print(f"Project target: {target['host']}:{remote_dir}/screenshots")
            print(f"  Mapped local project: {short(directory)}")
        if host or remote_home:
            print(f"Home-mirroring fallback: {host or '?'}  "
                  f"(remote home {remote_home or 'auto-detect'})  [from {source}]")
        for name in ("SC_SYNC_HOST", "OM_HOST", "SC_SYNC_REMOTE_HOME"):
            if os.environ.get(name):
                print(f"Environment override: {name}={os.environ[name]}")
        cache = load_home_cache()
        if cache:
            print("Known remote homes (use with --to):")
            for key in sorted(cache):
                print(f"  {key}  {cache[key]}")
        return 0

    if remote_dir_arg:
        if len(rest) != 2 or not rest[1]:
            sync_config_usage()
            return 1
        if not remote_dir_arg.startswith("/"):
            print(f"Remote project directory must be an absolute path (got: {remote_dir_arg})")
            return 1
        target = {"host": rest[1], "remote_dir": posixpath.normpath(remote_dir_arg)}
        settings = load_project_settings()
        if DRY_RUN:
            print(f"Would map {short(PWD)} to {target['host']}:{target['remote_dir']}/screenshots")
            return 0
        settings[PWD] = target
        ensure_config_dir(SYNC_PROJECTS_FILE)
        with open(SYNC_PROJECTS_FILE, "w") as fh:
            json.dump(settings, fh, indent=2, sort_keys=True)
            fh.write("\n")
        print(f"Project target: {target['host']}:{target['remote_dir']}/screenshots")
        print(f"  Mapped local project: {short(PWD)}")
        return 0

    if len(rest) != 3 or not rest[1] or not rest[2]:
        sync_config_usage()
        return 1
    host_arg, home_arg = rest[1:]
    if not home_arg.startswith("/"):
        print(f"Remote home must be an absolute path (got: {home_arg})")
        return 1
    if DRY_RUN:
        print(f"Would set home-mirroring fallback: {host_arg}  (remote home {home_arg})")
        return 0
    ensure_config_dir(SYNC_CONFIG_FILE)
    with open(SYNC_CONFIG_FILE, "w") as fh:
        fh.write(f"SC_SYNC_HOST={host_arg}\nSC_SYNC_REMOTE_HOME={home_arg}\n")
    print(f"Home-mirroring fallback: {host_arg}  (remote home {home_arg})")
    return 0


def cmd_sync(rest, to="", remote_home_arg="", remote_dir_arg=""):
    if remote_home_arg and remote_dir_arg:
        print("--remote-home and --remote-dir cannot be used together.")
        return 1
    if rest and rest[0] == "config":
        return cmd_sync_config(rest, to, remote_home_arg, remote_dir_arg)
    if rest:
        print("Usage: sc sync [-n] [--to <host>] [--remote-home <path> | --remote-dir <path>]")
        sync_config_usage()
        return 1
    for label, path in (("Remote home", remote_home_arg), ("Remote project directory", remote_dir_arg)):
        if path and not path.startswith("/"):
            print(f"{label} must be an absolute path (got: {path})")
            return 1

    cfg_host, cfg_home, _ = load_sync_config()
    directory, target = nearest_setting(load_project_settings())
    env_host = os.environ.get("SC_SYNC_HOST") or os.environ.get("OM_HOST")
    host = to or env_host or (target["host"] if target else cfg_host)
    if not host:
        print("Sync not configured.")
        sync_config_usage()
        return 1
    if not os.path.isdir("screenshots"):
        print(f"No ./screenshots dir here ({short(PWD)}). Nothing to sync.")
        return 1

    # Explicit destinations beat environment and project settings. A project path
    # belongs only to its saved host; changing hosts falls back to home mirroring.
    home_override = remote_home_arg or os.environ.get("SC_SYNC_REMOTE_HOME", "")
    if remote_dir_arg:
        remote_dir = posixpath.normpath(remote_dir_arg)
    elif target and host == target["host"] and not home_override:
        remote_dir = project_remote_dir(directory, target)
    else:
        if not is_within(PWD, HOME):
            print("cwd is outside $HOME; cannot mirror path to remote. Use --remote-dir.")
            return 1
        remote_home = home_override or (cfg_home if host == cfg_host else "")
        if not remote_home:
            remote_home = load_home_cache().get(host, "")
        if not remote_home:
            remote_home = detect_remote_home(host)
            if not remote_home:
                print(f"Could not determine $HOME on {host} over ssh.")
                print("  Pass --remote-home <path> or --remote-dir <project-path>.")
                return 1
            if not DRY_RUN:
                save_home_cache(host, remote_home)
        if not remote_home.startswith("/"):
            print(f"Remote home must be an absolute path (got: {remote_home})")
            return 1
        relative = os.path.relpath(PWD, HOME)
        remote_dir = posixpath.normpath(remote_home)
        if relative != ".":
            remote_dir = posixpath.join(remote_dir, relative)

    opts = ["-avP"]  # no -z: screenshots are already-compressed images
    rsync_path = "rsync"
    if DRY_RUN:
        opts.append("--dry-run")
    else:
        rsync_path = f"mkdir -p {shlex.quote(remote_dir)} && rsync"
    suffix = "  (dry-run)" if DRY_RUN else ""
    print(f"Pushing ./screenshots  →  {host}:{posixpath.join(remote_dir, 'screenshots')}{suffix}", flush=True)
    # Quote for the remote shell too; argv protects only the local invocation.
    remote_destination = shlex.quote(remote_dir.rstrip("/") + "/")
    cmd = (["rsync"] + opts
           + [f"--rsync-path={rsync_path}", "screenshots", f"{host}:{remote_destination}"])
    # rsync's manual recommends these for scripts that quote remote arguments:
    # newer versions must not escape our quotes again; older versions ignore them.
    rsync_env = dict(os.environ, RSYNC_OLD_ARGS="1", RSYNC_PROTECT_ARGS="0")
    return subprocess.run(cmd, env=rsync_env).returncode


def cmd_clean():
    files = all_screenshots()
    if len(files) <= 1:
        print("Nothing to clean (<=1 screenshot).")
        return 0
    to_delete = files[1:]
    if DRY_RUN:
        print(f"Dry run -- would remove {len(to_delete)} screenshot(s):")
        for f in to_delete:
            print(f"  {short(f)}")
        print(f"Would keep: {short(files[0])}")
    else:
        for f in to_delete:
            os.remove(f)
        print(f"Removed {len(to_delete)} old screenshot(s). Kept: {short(files[0])}")
    return 0


def cmd_nuke():
    files = all_screenshots()
    if not files:
        print("No screenshots to remove.")
        return 0
    if DRY_RUN:
        print(f"Dry run -- would remove {len(files)} screenshot(s):")
        for f in files:
            print(f"  {short(f)}")
    else:
        for f in files:
            os.remove(f)
        print(f"Removed {len(files)} screenshot(s).")
    return 0


def cmd_default():
    file = latest()
    if not file:
        print("No screenshots found.")
        return 1
    print(short(file))
    copy_to_clipboard(file)
    return 0


# --- arg parsing & dispatch ------------------------------------------------

def build_parser():
    # Global flags live on a parent parser so they're accepted before OR after the
    # subcommand (e.g. `sc -p cp` and `sc cp -p`). default=SUPPRESS keeps a subparser
    # from clobbering a value already set on the main parser.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-p", "--path", action="store_true", default=argparse.SUPPRESS,
                        help="copy file path instead of image contents")
    common.add_argument("-n", "--dry-run", action="store_true", default=argparse.SUPPRESS,
                        help="preview clean/nuke deletions, auto/config changes, or rsync sync")

    parser = argparse.ArgumentParser(
        prog="sc", parents=[common],
        description="Screenshot utility for macOS. With no command: print path + copy image.")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("print", parents=[common], help="print the latest screenshot path")
    sub.add_parser("list", parents=[common], help="list all screenshots")
    sub.add_parser("open", parents=[common], help="open the latest screenshot")
    sub.add_parser("cp", parents=[common], help="copy latest screenshot (image or path) to clipboard")

    p_mv = sub.add_parser("mv", parents=[common],
                          help="move latest screenshot (default: screenshots/<today>/<dest>)",
                          description="Relative destinations default to screenshots/<today>/. "
                          "Use 'sc auto off' to disable, or an absolute/screenshots path to override.")
    p_mv.add_argument("dest", nargs="?", default="", help="destination path or directory")

    p_auto = sub.add_parser("auto", parents=[common],
                            help="toggle per-dir 'screenshots/<today>/' prefix for mv (default: on)")
    p_auto.add_argument("action", nargs="?", default="status",
                        help="on | off | status (default: status)")

    p_sync = sub.add_parser("sync", parents=[common],
                            help="push ./screenshots to a remote project (rsync)",
                            description="Project mappings inherit into subdirectories; otherwise mirror "
                            "the local path relative to $HOME. --remote-dir names the remote project, "
                            "not its screenshots folder.")
    p_sync.add_argument("rest", nargs="*",
                        help="'config' to show; 'config HOST HOME' for global mirroring; "
                        "'config HOST --remote-dir PATH' for this project; empty to push")
    p_sync.add_argument("--to", default="", metavar="HOST",
                        help="push to HOST for this run instead of the configured target")
    destinations = p_sync.add_mutually_exclusive_group()
    destinations.add_argument("--remote-home", default="", metavar="PATH",
                              help="remote $HOME for this push (skips ssh detection)")
    destinations.add_argument("--remote-dir", default="", metavar="PATH",
                              help="exact remote project directory, for this push or project config")

    sub.add_parser("clean", parents=[common], help="remove all screenshots except the latest")
    sub.add_parser("nuke", parents=[common], help="remove ALL screenshots")
    return parser


def main(argv):
    global COPY_PATH, DRY_RUN
    args = build_parser().parse_args(argv)
    COPY_PATH = getattr(args, "path", False)
    DRY_RUN = getattr(args, "dry_run", False)

    dispatch = {
        None: cmd_default,
        "print": cmd_print,
        "list": cmd_list,
        "open": cmd_open,
        "cp": cmd_cp,
        "clean": cmd_clean,
        "nuke": cmd_nuke,
    }
    if args.command in dispatch:
        return dispatch[args.command]()
    if args.command == "mv":
        return cmd_mv(args.dest)
    if args.command == "auto":
        return cmd_auto(args.action)
    if args.command == "sync":
        return cmd_sync(args.rest, args.to, args.remote_home, args.remote_dir)
    return 1  # unreachable: argparse rejects unknown commands


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as exc:
        print(f"sc: {exc}", file=sys.stderr)
        sys.exit(1)
