Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    # Keeps the master connection alive in the background for 10 minutes after you disconnect your first session. Change this to yes to keep the socket alive indefinitely, or 0 to close it immediately upon exit.
    ControlPersist 10m
    # Detect dead peers (e.g. a flaky mesh route) within ~60s instead of
    # hanging an ESTABLISHED-but-dead connection forever.
    # Linux lane wedging on a half-dead SSH heredoc.
    ServerAliveInterval 15
    ServerAliveCountMax 4

