#! /usr/bin/env bash

# Author: Gaurav Agarwal
# Inspired by https://github.com/livingston/shell-scripts/blob/master/gua.sh
# "Unix was not designed to stop its users from doing stupid things, as that would also stop them from doing clever things." – Doug Gwyn

git_args=("$@")

if [ $# -eq 0 ] || [ "$1" = "help" ]; then
  echo "Runs the git command on submodules, nested repositories, and then the current repository root.
  Usage:
  	\$ git multi status
  	\$ git multi remote update
  	\$ git multi pull --rebase
  	\$ git multi commit -m \"Commit message with spaces\""
  exit 0
fi

start_time=$(date +%s)
base=$(pwd)
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
failed=0

function run_command {
  heading=$1
  shift
  count=$#
  printf '\033[1;33m%s %s found:\033[0m\n' "$count" "$heading"
  for repo in "$@"
  do
    echo "  $repo"
  done
  echo ""

  i=0
  for repo in "$@";
  do
    [ -n "$repo" ] || continue
    ((i += 1))
    cd "$repo"
    printf '\033[1;33mOn %s of %s - \033[1;35m%s\r\033[0m\n' "$i" "$count" "$repo"

    if ! git "${git_args[@]}"; then
      failed=1
    fi

    cd "$base"
    echo ""
  done
}

function add_unique {
  local item=$1
  shift

  for existing in "$@"; do
    if [ "$existing" = "$item" ]; then
      return 1
    fi
  done

  return 0
}

repositories=()

if [ -n "$repo_root" ] && [ -f "$repo_root/.gitmodules" ]; then
  while read -r _ path; do
    [ -n "$path" ] || continue
    abs_path="$repo_root/$path"
    [ -e "$abs_path" ] || continue

    case "$abs_path" in
      "$base"/*|"$base")
        display_path=${abs_path#"$base"/}
        if add_unique "$display_path" "${repositories[@]}"; then
          repositories+=("$display_path")
        fi
        ;;
    esac
  done < <(git config --file "$repo_root/.gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null || true)
fi

while read -r repo; do
  [ -n "$repo" ] || continue
  if add_unique "$repo" "${repositories[@]}"; then
    repositories+=("$repo")
  fi
done < <(find . -mindepth 2 -maxdepth 2 \( -type d -name '.git' -o -type f -name '.git' \) | cut -d '/' -f 2 | sort)

mapfile -t symlinks < <(find . -maxdepth 1 -type l | cut -d '/' -f 2)

if [ -n "$repo_root" ]; then
  if [ "$repo_root" = "$base" ]; then
    root_entry="."
  else
    root_entry="$repo_root"
  fi
  if add_unique "$root_entry" "${repositories[@]}"; then
    repositories+=("$root_entry")
  fi
fi

run_command "repositories and submodules" "${repositories[@]}"
run_command "symlinks" "${symlinks[@]}"

printf '\033[1;31mgit multi %s took %s sec(s).\033[0m\n' "${git_args[*]}" "$(($(date +%s) - start_time))"
exit "$failed"
