#! /usr/bin/env bash

# Author: Gaurav Agarwal
# Inspired by https://github.com/livingston/shell-scripts/blob/master/gua.sh
# "Unix was not designed to stop its users from doing stupid things, as that would also stop them from doing clever things." – Doug Gwyn

command_to_run=$*

if [ -z "$command_to_run" ] || [ "$command_to_run" = "help" ]; then
  echo "Runs a shell command on submodules, nested repositories, and then the current repository root.
  Usage:
    \$ git multi-sh tree
    \$ git multi-sh ls
    \$ git multi-sh git status"
  exit 0
fi

start_time=`date +%s`
base=$(pwd)
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
failed=0

function add_unique {
  local item=$1
  shift

  for existing in "$@"; do
    if [ "$existing" = "$item" ]; then
      return 1
    fi
  done

  return 0
}

repository_list=()

if [ -n "$repo_root" ] && [ -f "$repo_root/.gitmodules" ]; then
  while read -r _ path; do
    [ -n "$path" ] || continue
    abs_path="$repo_root/$path"
    [ -e "$abs_path" ] || continue

    case "$abs_path" in
      "$base"/*|"$base")
        display_path=${abs_path#"$base"/}
        if add_unique "$display_path" "${repository_list[@]}"; then
          repository_list+=("$display_path")
        fi
        ;;
    esac
  done < <(git config --file "$repo_root/.gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null || true)
fi

while read -r repo; do
  [ -n "$repo" ] || continue
  if add_unique "$repo" "${repository_list[@]}"; then
    repository_list+=("$repo")
  fi
done < <(find . -mindepth 2 -maxdepth 2 \( -type d -name '.git' -o -type f -name '.git' \) | cut -d '/' -f 2 | sort)

if [ -n "$repo_root" ] && [ "$repo_root" = "$base" ]; then
  repository_list+=(".")
fi

repository_count=${#repository_list[@]}

printf '\033[1;33m%s repositories and submodules found:\033[0m\n' "$repository_count"
for (( i=0; i<${repository_count}; i++ ));
do
  echo "  ${repository_list[$i]}"
done
echo ""

for (( i=0; i<${repository_count}; i++ ));
do
  cd "${repository_list[$i]}"
  printf '\033[1;33mOn %s of %s - \033[1;35m%s\r\033[0m\n' "$((i + 1))" "$repository_count" "${repository_list[$i]}"

  if ! time $command_to_run; then
    failed=1
  fi

  cd $base
  echo ""
done

printf '\033[1;31mgit multi-sh %s took %s sec(s).\033[0m\n' "$command_to_run" "$((`date +%s` - $start_time))"
exit "$failed"
