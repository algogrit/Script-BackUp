#!/usr/bin/env bash
set -euo pipefail

# git resub — wipe every submodule in the current repo and replace each with a
# plain standalone `git clone` (its own .git dir), left on its default branch.
# NOTE: relative submodule URLs (../foo.git) are not resolved; assumes absolute.

usage() {
  printf '%s\n' \
    'Usage: git resub [-y]' \
    '  Wipe every submodule in the current repo and replace it with a plain' \
    '  standalone `git clone` (own .git dir), left on its default branch.' \
    '  -y   skip the confirmation prompt'
}

skip_confirm=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -y|--yes)  skip_confirm=1; shift ;;
    *) usage >&2; exit 2 ;;
  esac
done

root=$(git rev-parse --show-toplevel)

if [ ! -f "$root/.gitmodules" ]; then
  printf '%s\n' 'git resub: no .gitmodules found — nothing to do.'
  exit 0
fi

# Collect submodule name/path/url triples (bash 3.2-safe: no mapfile).
names=(); paths=(); urls=()
while IFS= read -r name; do
  [ -n "$name" ] || continue
  p=$(git config --file "$root/.gitmodules" --get "submodule.$name.path")
  u=$(git -C "$root" config --get "submodule.$name.url" 2>/dev/null || true)
  [ -n "$u" ] || u=$(git config --file "$root/.gitmodules" --get "submodule.$name.url")
  names+=("$name"); paths+=("$p"); urls+=("$u")
done < <(git config --file "$root/.gitmodules" --get-regexp '^submodule\..*\.path$' \
           | sed -E 's/^submodule\.(.*)\.path .*/\1/')

if [ "${#paths[@]}" -eq 0 ]; then
  printf '%s\n' 'git resub: no submodules registered — nothing to do.'
  exit 0
fi

printf '\033[1;33mThese submodules will be wiped and re-cloned (default branch):\033[0m\n'
for p in "${paths[@]}"; do printf '  %s\n' "$p"; done

if [ "$skip_confirm" -ne 1 ]; then
  printf 'Proceed? This discards any local changes in these dirs [y/N] '
  read -r answer
  case "$answer" in y|Y|yes|YES) ;; *) echo 'Aborted.'; exit 1 ;; esac
fi

i=0
while [ "$i" -lt "${#paths[@]}" ]; do
  name=${names[$i]}; sm=${paths[$i]}; url=${urls[$i]}
  printf '\033[1;33m==> %s\033[0m\n' "$sm"
  git -C "$root" submodule deinit -f -- "$sm" 2>/dev/null || true
  rm -rf "$root/$sm"
  rm -rf "$root/.git/modules/$name"
  git clone "$url" "$root/$sm"
  i=$((i + 1))
done

printf '\033[1;33mDone. Re-cloned %s submodule(s) as standalone clones.\033[0m\n' "${#paths[@]}"
