alias ollama-refresh-all="ollama list | awk 'NR>1 {print $1}' | xargs -n 1 ollama pull"

# alias codellama='ollama run codellama:13b-code'
# alias deepseek-coder='ollama run DeepSeek-Coder:6.7b'
# alias deepseek='ollama run deepseek-r1:latest'
# alias gemma3='ollama run gemma3:latest'
# alias llama3.1='ollama run llama3.1:8b'
# alias mistral='ollama run mistral:latest'
# alias mistral-small='ollama run mistral-small3.1:latest'
# alias phi4='ollama run phi4:latest'

NODENV_GLOBAL="$(nodenv global)"
CODEX_BIN="$(NODENV_VERSION="$NODENV_GLOBAL" nodenv which codex)"

alias codex="$CODEX_BIN --model gpt-5.6-terra --sandbox workspace-write --ask-for-approval on-request"
alias codex-hard="$CODEX_BIN --model gpt-5.6-sol --sandbox workspace-write --ask-for-approval on-request"
alias codex-commit="$CODEX_BIN --model gpt-5.6-luna \"review and commit\" --sandbox workspace-write --ask-for-approval on-request"

alias claude='claude --enable-auto-mode --permission-mode=plan --model=opus --effort=high'
alias claude-hard='claude --enable-auto-mode --permission-mode=plan --model=fable'
alias claude-commit='claude --enable-auto-mode --permission-mode=auto --model=sonnet "review and commit"'

alias gclaude='\agy --model "Claude Opus 4.6 (Thinking)" --add-dir "$(pwd)" -i "/plan"'
alias gclaude-commit='\agy --model "Claude Sonnet 4.6 (Thinking)" --add-dir "$(pwd)" --dangerously-skip-permissions -i "review and commit"'

alias gemini='\agy --add-dir "$(pwd)"'
alias gemini-grill='\agy --add-dir "$(pwd)" -i "/grill-me"'
alias gemini-commit='\agy --model "Gemini 3.1 Pro (High)" --add-dir "$(pwd)" --dangerously-skip-permissions -i "review and commit"'
