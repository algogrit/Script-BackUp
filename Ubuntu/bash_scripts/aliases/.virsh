alias vm-list="virsh list --all"
alias aditi-start="virsh start aditi"
alias aditi-stop="virsh shutdown aditi"
alias aditi-stop-f="virsh destroy aditi"
alias aditi-reboot="virsh reboot aditi"
alias aditi-reboot-f="virsh reset aditi"

alias shanidev-start="virsh start shanidev"
alias shanidev-stop="virsh shutdown shanidev"
alias shanidev-stop-f="virsh destroy shanidev"
alias shanidev-reboot="virsh reboot shanidev"
alias shanidev-reboot-f="virsh reset shanidev"
alias shanidev-status="virsh dominfo shanidev"
alias shanidev-console="virt-manager --connect qemu:///system --show-domain-console shanidev"
alias shanidev-ssh="ssh shanidev"
