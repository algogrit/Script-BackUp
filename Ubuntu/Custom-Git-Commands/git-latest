#! /usr/bin/env sh

# --sort=-committerdate orders on the underlying timestamp, so branches
# committed in different UTC offsets still sort correctly; sorting the
# formatted date strings instead gets that backwards.
#
# Columns are tab-separated because commit subjects and author names may
# contain commas.

TAB=$(printf '\t')

git for-each-ref --sort=-committerdate refs/remotes/ \
  --exclude='refs/remotes/*/HEAD' \
  --format="%(committerdate:iso8601-strict)${TAB}%(committerdate:relative)${TAB}%(authorname)${TAB}%(refname:short)${TAB}%(contents:subject)" |
  column -t -s "$TAB"
